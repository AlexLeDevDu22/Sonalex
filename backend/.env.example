# Sonalex server – copy to backend/.env and fill in. Never commit backend/.env.

# Jellyfin, as this machine reaches it, and an administrator account the server signs in with
# (it reads file paths to analyse songs for the Mix).
SONALEX_JELLYFIN_URL=http://127.0.0.1:8096
JELLYFIN_USER=
JELLYFIN_PW=
# Optional: found by signing in when empty.
JELLYFIN_USER_ID=

# Music, state, logs and temporary files.
SONALEX_DATA_DIR=/srv/sonalex

# --- Optional modules (off by default) -------------------------------------------------------
# Online catalog: search, stream and save songs that aren't in your library. It fetches audio
# from YouTube: check that this is allowed where you live before turning it on.
SONALEX_ONLINE=0
# Its Spotify search: your own keys (free), from an app made on https://developer.spotify.com/dashboard
# (client credentials). Without them, the account token of the Spotify sync is used.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Keeps the library in sync with a Spotify account (likes, playlists). Needs backend/chosic_data.json.
SONALEX_SPOTIFY_SYNC=0
SPOTIFY_USER_ID=
# Recommendations (autoplay, stations) – https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_API_SECRET=
