[Unit]
Description=Hosted Spotify Full Refresh (sync Spotify <-> Jellyfin)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/alex/Hosted-Spotify/backend
ExecStart=/home/alex/Hosted-Spotify/backend/.venv/bin/python /home/alex/Hosted-Spotify/backend/full_refreshing.py
# The run writes its own log: /srv/Hosted-Spotify/logs/sync-YYYY-MM-DD.log (30 days kept).
StandardOutput=null
StandardError=append:/home/alex/Hosted-Spotify/backend/full_refreshing-user-error.log
TimeoutStartSec=4h
Nice=10
