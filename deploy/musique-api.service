[Unit]
Description=Musique API (catalogue en ligne, streaming, recommandations)
After=network-online.target

[Service]
WorkingDirectory=/home/alex/Hosted-Spotify/backend
Environment=MUSIQUE_JELLYFIN_URL=http://127.0.0.1:8097
ExecStart=/home/alex/Hosted-Spotify/backend/.venv/bin/python -u -m uvicorn api.server:app --host 127.0.0.1 --port 8098 --timeout-graceful-shutdown 3
StandardOutput=append:/home/alex/Hosted-Spotify/backend/musique-api.log
StandardError=append:/home/alex/Hosted-Spotify/backend/musique-api.log
Restart=always
RestartSec=3
TimeoutStopSec=5
KillMode=mixed

[Install]
WantedBy=default.target
