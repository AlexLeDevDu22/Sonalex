# Relais sur le port public de Jellyfin (8096) :
#   /musique/*  → Musique API (recherche en ligne, streaming, recommandations), 127.0.0.1:8098
#   le reste    → Jellyfin, déplacé en interne sur 127.0.0.1:8097
{
	admin off
	auto_https off
	persist_config off
}

:8096 {
	handle_path /musique/* {
		reverse_proxy 127.0.0.1:8098 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8097 {
			flush_interval -1
		}
	}
}
