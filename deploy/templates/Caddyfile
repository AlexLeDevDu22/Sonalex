# One public address for the app:
#   /sonalex/*  → Sonalex server, 127.0.0.1:@SERVER_PORT@ (/musique/*: the name before, for older apps)
#   the rest    → Jellyfin, moved to 127.0.0.1:@JELLYFIN_PORT@
{
	admin off
	auto_https off
	persist_config off
}

:@PUBLIC_PORT@ {
	@server path /sonalex/* /musique/*
	handle @server {
		uri strip_prefix /sonalex
		uri strip_prefix /musique
		reverse_proxy 127.0.0.1:@SERVER_PORT@ {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy 127.0.0.1:@JELLYFIN_PORT@ {
			flush_interval -1
		}
	}
}
